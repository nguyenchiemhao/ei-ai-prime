# Local environment variables. `npm run up` copies this file to `.env` (git-ignored) on first run and
# replaces every __GENERATED__ value with a random password. Never commit .env; never put a real
# secret in this file.

# PostgreSQL superuser password: provisioning only (the API never uses it).
POSTGRES_PASSWORD=__GENERATED__

# Password of the application login role ei_ai_app (NOSUPERUSER, NOBYPASSRLS). The API connects with it.
# Passwords are fixed when the database volume is first created; after changing them run `npm run reset`.
APP_DB_PASSWORD=__GENERATED__

# Password of the migration/owner role ei_ai_migrator (NOSUPERUSER, NOBYPASSRLS; owns the tables and runs
# the migrations). Used only by the migrate service and the backend test container; the API never gets it.
# Fixed when the database volume is first created; after changing it run `npm run reset`.
MIGRATION_DB_PASSWORD=__GENERATED__

# Name of the Docker volume that caches the model file (~2.5 GB). Default: ei-ai-model-cache.
# To reuse the volume of the EA-11 stack spike: MODEL_CACHE_VOLUME=ei-ai-stack-spike_model-cache
# MODEL_CACHE_VOLUME=

# Host port of the admin UI (default 3000). Set it when 3000 is taken by another program; Compose, the
# smoke test, Playwright and the set-password links follow it.
# ADMIN_PORT=3000

# Isolated runs (a second copy of the stack side by side): COMPOSE_PROJECT_NAME=ei-ai-other
# (ports are fixed, so stop the main stack first).
# COMPOSE_PROJECT_NAME=

# Model overrides (defaults are pinned in compose.yaml; FND-07 adds the model catalog).
# LLM_ALIAS=qwen3-4b-instruct-2507
# LLM_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# LLM_MODEL_URL=
