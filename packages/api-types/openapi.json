{
  "components": {
    "schemas": {
      "CurrentOrganization": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "title": "CurrentOrganization",
        "type": "object"
      },
      "ErrorCode": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorCode",
        "type": "object"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthStatus",
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "database": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database",
            "type": "string"
          },
          "valkey": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Valkey",
            "type": "string"
          }
        },
        "required": [
          "database",
          "valkey"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "ReadinessStatus": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "ReadinessStatus",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ei-ai",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "The process is up. Never calls a dependency.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe"
      }
    },
    "/organization": {
      "get": {
        "description": "Always the Organization of the verified token or session. An ``org_id`` sent in a header or\nquery parameter is ignored (D32); the database also restricts the query to that Organization\n(D46), so the explicit filter below is the first of two layers.",
        "operationId": "get_organization_organization_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentOrganization"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorCode"
                }
              }
            },
            "description": "No valid identity (detail: unauthenticated)"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorCode"
                }
              }
            },
            "description": "The Organization does not exist (not_found)"
          }
        },
        "summary": "The Organization of the verified identity"
      }
    },
    "/readyz": {
      "get": {
        "description": "Database and Valkey are reachable. Reports component names and ok/unavailable only.",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessStatus"
                }
              }
            },
            "description": "A dependency is unavailable"
          }
        },
        "summary": "Readiness probe"
      }
    }
  }
}
