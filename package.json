{
  "name": "ei-ai",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @ei-ai/design-tokens && npm run build -w @ei-ai/admin -w @ei-ai/widget",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p e2e",
    "test:frontend": "npm run test --workspaces --if-present",
    "api-types:check": "npm run check -w @ei-ai/api-types",
    "dev:admin": "npm run build -w @ei-ai/design-tokens && npm run dev -w @ei-ai/admin",
    "dev:widget": "npm run build -w @ei-ai/design-tokens && npm run dev -w @ei-ai/widget",
    "up": "node scripts/dev.mjs up",
    "down": "node scripts/dev.mjs down",
    "reset": "node scripts/dev.mjs reset",
    "migrate": "node scripts/dev.mjs migrate",
    "seed": "node scripts/dev.mjs seed",
    "ps": "node scripts/dev.mjs ps",
    "logs": "node scripts/dev.mjs logs",
    "backend": "node scripts/backend.mjs",
    "check": "node scripts/check.mjs",
    "test": "npm run test:frontend && node scripts/run-node-checks.mjs && node scripts/backend.mjs test",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
